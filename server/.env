# PADDOCK server configuration. No secrets are required: Jolpica is a public API.
PORT=5001
# Origin allowed to call the API from a browser (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# Python interpreter used by the prediction model (needs pandas, numpy, scikit-learn).
PYTHON_BIN=python3
# First season used to train the model. Earlier seasons are not fetched.
MODEL_FIRST_SEASON=2014
# First season of the walk-forward backtest shown on the Prediction page.
BACKTEST_FIRST_SEASON=2022
